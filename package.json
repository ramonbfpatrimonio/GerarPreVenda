{
  "name": "gerar-pre-venda",
  "productName": "Gerar Pré-Venda",
  "version": "1.2.18",
  "description": "Gera pré-vendas no ERP (SQL Server) a partir de pedidos de compra em PDF, com conexões por cliente",
  "author": "Ramon",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "demo": "vite --config vite.demo.config.ts",
    "rebuild:nativo": "electron-rebuild -f -w msnodesqlv8"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "mssql": "11.0.2",
    "pdfjs-dist": "4.10.38"
  },
  "optionalDependencies": {
    "msnodesqlv8": "4.5.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.1.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/mssql": "9.1.5",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "36.9.5",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "@electron/rebuild": "3.7.1"
  }
}
